#.vscode/
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Build output of this CLI — releases are produced by CI, never committed.
# Never ignore a bare "scaffold": that is the package directory.
/bin/
/main
scaffold-cli
scaffold-cli-*

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Python bytecode degli script in docs/scripts/
__pycache__/
*.pyc
