package main

import (
	"github.com/gofiber/fiber/v2"

	"{{.ProjectPath}}/internal/{{.Module}}/application"
	"{{.ProjectPath}}/internal/{{.Module}}/domain"
	"{{.ProjectPath}}/internal/{{.Module}}/infrastructure"
	httptransport "{{.ProjectPath}}/internal/{{.Module}}/transport/http"
)

// Wiring of the {{.Module}} bounded context, generated by `scaffold add module`.
// This file is the module's whole composition root: delete it and the module is
// no longer mounted.
func init() {
	register(module{name: "{{.Module}}", mount: mount{{.ModuleTitle}}})
}

func mount{{.ModuleTitle}}(api fiber.Router, d deps) error {
	var repo domain.Repository
	if d.db != nil {
		store := infrastructure.NewGormStore(d.db)
		if err := store.Migrate(); err != nil {
			return err
		}
		repo = store
	} else {
		d.log.Warnw("no database: data is kept in memory and lost on restart", "module", "{{.Module}}")
		repo = infrastructure.NewMemoryStore()
	}

	svc := application.NewService(repo)
	httptransport.NewHandler(svc, d.log).Register(api.Group("/{{.Module}}"))
	return nil
}
