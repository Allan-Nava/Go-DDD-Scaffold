// Command {{.ProjectName}} is the HTTP entrypoint of the service.
package main

import (
	"os"
	"os/signal"
	"strings"
	"syscall"
	"time"

	"github.com/gofiber/fiber/v2"
	"github.com/gofiber/fiber/v2/middleware/cors"
	"github.com/gofiber/fiber/v2/middleware/logger"
	"github.com/gofiber/fiber/v2/middleware/recover"
	"go.uber.org/zap"
	"gorm.io/gorm"

	"{{.ProjectPath}}/database"
	"{{.ProjectPath}}/env"
)

const shutdownTimeout = 10 * time.Second

// newApp builds the router and its middlewares. It is separate from main so the
// tests can drive it through app.Test, with no port to bind and no database.
//
// allowedOrigins are the browser origins that may call the API cross-origin.
// None (the default) installs no CORS middleware: browsers then block every
// cross-origin call, which is the safe starting point for a new service.
func newApp(name string, allowedOrigins []string) *fiber.App {
	app := fiber.New(fiber.Config{
		AppName:               name,
		DisableStartupMessage: true,
		ReadTimeout:           15 * time.Second,
		WriteTimeout:          15 * time.Second,
	})
	// recover first, so a panic in any later middleware is still caught.
	app.Use(recover.New())
	app.Use(logger.New())
	if origins := cleanOrigins(allowedOrigins); len(origins) > 0 {
		app.Use(cors.New(cors.Config{
			AllowOrigins: strings.Join(origins, ","),
			AllowHeaders: "Content-Type, Authorization",
			AllowMethods: "GET, HEAD, OPTIONS, PUT, PATCH, POST, DELETE",
		}))
	}

	app.Get("/health", func(c *fiber.Ctx) error {
		return c.SendStatus(fiber.StatusOK)
	})

	return app
}

// cleanOrigins drops the blanks a "a, b," list leaves behind.
func cleanOrigins(origins []string) []string {
	out := make([]string, 0, len(origins))
	for _, o := range origins {
		if o = strings.TrimSpace(o); o != "" {
			out = append(out, o)
		}
	}
	return out
}

func main() {
	// Info until the configuration is loaded, then LOG_LEVEL.
	level := zap.NewAtomicLevel()
	zcfg := zap.NewProductionConfig()
	zcfg.Level = level
	log := zap.Must(zcfg.Build()).Sugar()
	defer log.Sync() //nolint:errcheck // nothing useful to do on a failed flush

	cfg, err := env.GetEnvConfig(log)
	if err != nil {
		log.Fatalw("cannot load the configuration", "err", err)
	}
	level.SetLevel(cfg.LogLevel)

	app := newApp("{{.ProjectName}}", cfg.CORSAllowedOrigins)

	// The database is optional, so a freshly generated project runs without one.
	var db *gorm.DB
	if cfg.DBHost != "" {
		db, err = database.InitDB(log, cfg)
		if err != nil {
			log.Fatalw("cannot open the database", "err", err)
		}
	} else {
		log.Warn("DB_HOST is empty: starting without a database")
	}

	// Every bounded context under /api (see cmd/modules.go).
	if err := mountModules(app.Group("/api"), deps{db: db, log: log}); err != nil {
		log.Fatalw("cannot mount the modules", "err", err)
	}

	go func() {
		log.Infow("listening", "addr", cfg.HTTPAddr)
		if err := app.Listen(cfg.HTTPAddr); err != nil {
			log.Fatalw("server stopped", "err", err)
		}
	}()

	// Wait for SIGINT/SIGTERM, then drain the in-flight requests.
	quit := make(chan os.Signal, 1)
	signal.Notify(quit, os.Interrupt, syscall.SIGTERM)
	<-quit

	log.Infow("shutting down", "timeout", shutdownTimeout)
	if err := app.ShutdownWithTimeout(shutdownTimeout); err != nil {
		log.Errorw("shutdown did not complete", "err", err)
	}
}
