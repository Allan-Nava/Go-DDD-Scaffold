package main

import (
	"fmt"

	"github.com/gofiber/fiber/v2"
	"go.uber.org/zap"
	"gorm.io/gorm"
)

// The composition root: this is the only place that knows every layer and
// wires them together, by hand (no DI framework, nothing hidden).
//
// Each bounded context has its own cmd/module_<name>.go, generated by
// `scaffold add module <name>`, which registers itself here. Adding a module
// never edits an existing file; removing one is deleting its file and its
// internal/<name> folder.

// deps are the shared resources a module may need.
type deps struct {
	db  *gorm.DB // nil when DB_HOST is empty: modules fall back to memory
	log *zap.SugaredLogger
}

// module is a bounded context the service mounts under /api/<name>.
type module struct {
	name  string
	mount func(api fiber.Router, d deps) error
}

var modules []module

func register(m module) {
	modules = append(modules, m)
}

// mountModules mounts every registered module on api, in file-name order.
func mountModules(api fiber.Router, d deps) error {
	for _, m := range modules {
		if err := m.mount(api, d); err != nil {
			return fmt.Errorf("mount module %s: %w", m.name, err)
		}
		d.log.Infow("module mounted", "module", m.name, "prefix", "/api/"+m.name)
	}
	return nil
}
