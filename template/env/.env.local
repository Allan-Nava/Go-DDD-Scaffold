# Local development values only — never commit real credentials here.
# This file is git-ignored (see .gitignore): every value has a default, so a
# fresh clone still runs without it.
APP_ENV=local
LOG_LEVEL=debug
HTTP_ADDR=0.0.0.0:8080

# Browser origins allowed to call the API, comma-separated (e.g.
# http://localhost:3000). Empty = no cross-origin access, the safe default.
CORS_ALLOWED_ORIGINS=

# Empty DB_HOST = the service starts without a database, so `make run` works on a
# machine with no MySQL. `make up` starts the service and MySQL together; to run
# the service on the host against that MySQL, set DB_HOST=localhost.
DB_HOST=
DB_PORT=3306
DB_NAME=dbv
DB_USERNAME=db_user
DB_PASSWORD=db_password!
DB_IDLE_CONN=10
DB_MAX_CONN=100
