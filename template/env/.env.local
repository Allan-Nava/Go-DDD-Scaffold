# Local development values only — never commit real credentials here.
APP_ENV=local
LOG_LEVEL=debug
RUNNING_MODE=main
HTTP_ADDR=0.0.0.0:8080
API_SECRET=secret

# Leave DB_HOST empty to start the service without a database.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dbv
DB_USERNAME=db_user
DB_PASSWORD=db_password!
DB_IDLE_CONN=10
DB_MAX_CONN=100
