// Package env loads the service configuration from the environment.
package env

import (
	"fmt"

	goenv "github.com/caarlos0/env/v11"
	"github.com/joho/godotenv"
	"go.uber.org/zap"
	"go.uber.org/zap/zapcore"
)

// Configuration mirrors env/.env.<APP_ENV>. Every field comes from the
// environment, with a default that keeps local development runnable.
type Configuration struct {
	AppEnv   string        `env:"APP_ENV" envDefault:"local"`
	LogLevel zapcore.Level `env:"LOG_LEVEL" envDefault:"info"` // debug, info, warn, error
	HTTPAddr string        `env:"HTTP_ADDR" envDefault:"0.0.0.0:8080"`

	// CORSAllowedOrigins lists the browser origins allowed to call the API.
	// Empty means none: the service answers same-origin requests only.
	CORSAllowedOrigins []string `env:"CORS_ALLOWED_ORIGINS" envSeparator:","`

	DBHost     string `env:"DB_HOST"`
	DBPort     string `env:"DB_PORT" envDefault:"3306"`
	DBName     string `env:"DB_NAME"`
	DBUsername string `env:"DB_USERNAME"`
	DBPassword string `env:"DB_PASSWORD"`
	DBIdleConn int    `env:"DB_IDLE_CONN" envDefault:"10"`
	DBMaxConn  int    `env:"DB_MAX_CONN" envDefault:"100"`
}

// GetEnvConfig loads the dotenv file of the current APP_ENV, when present, then
// parses the environment into a Configuration.
func GetEnvConfig(log *zap.SugaredLogger) (*Configuration, error) {
	// The first pass only resolves APP_ENV, so its default lives in one place —
	// the struct tag — and an unset APP_ENV really means "local".
	cfg := Configuration{}
	if err := goenv.Parse(&cfg); err != nil {
		return nil, fmt.Errorf("parse environment: %w", err)
	}

	file := dotenvFile(cfg.AppEnv)
	if err := godotenv.Load(file); err != nil {
		log.Debugw("no dotenv file, reading the environment", "path", file)
	} else {
		// The dotenv file never overrides variables already set in the
		// environment; parse again to pick up the ones it added.
		cfg = Configuration{}
		if err := goenv.Parse(&cfg); err != nil {
			return nil, fmt.Errorf("parse environment (after %s): %w", file, err)
		}
	}

	log.Infow("configuration loaded",
		"app_env", cfg.AppEnv,
		"log_level", cfg.LogLevel,
		"http_addr", cfg.HTTPAddr,
		"database", cfg.DBHost != "",
	)
	return &cfg, nil
}

// dotenvFile maps APP_ENV to its dotenv file. A missing file is not an error:
// in a container the values come from the environment itself.
func dotenvFile(appEnv string) string {
	switch appEnv {
	case "local", "dev", "staging", "prod":
		return "./env/.env." + appEnv
	default:
		return ".env"
	}
}
